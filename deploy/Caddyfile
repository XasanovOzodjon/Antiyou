{
	email {$TLS_EMAIL}
	default_sni download.khasanoff.uz
	servers {
		protocols h1 h2
	}
}

http://download.khasanoff.uz {
	encode gzip
	request_body {
		max_size 80MB
	}
	reverse_proxy api:8000
}

