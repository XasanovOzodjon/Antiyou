	encode gzip
	request_body {
		max_size 80MB
	}
	tls {
		issuer acme {
			email {$TLS_EMAIL}
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
	}
	reverse_proxy api:8000
}
